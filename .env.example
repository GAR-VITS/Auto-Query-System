# PostgreSQL 16 role URLs used by the governed backend (owner / reader / writer)
DATABASE_URL_OWNER=postgresql+psycopg://nexus_owner:owner_secret@localhost:5432/nexus
DATABASE_URL_READER=postgresql+psycopg://nexus_reader:reader_secret@localhost:5432/nexus
DATABASE_URL_WRITER=postgresql+psycopg://nexus_writer:writer_secret@localhost:5432/nexus

# Legacy single-URL used by older db scripts and root helpers
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_finance

# JWT signing secret for demo auth (replace in any real deployment)
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# Google Gemini (leave empty to run FakeLLM when DEMO_MODE=true)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Semantic memory / ChromaDB
EMBEDDING_BACKEND=local
CHROMA_PATH=./.chroma
TOP_K_SCHEMA_SLICES=8

# Pipeline execution
DEMO_MODE=true
MAX_RETRIES=3
STATEMENT_TIMEOUT_MS=5000
ROW_CAP=1000

# CORS and frontend API base
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
